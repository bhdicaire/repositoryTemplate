{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-CA",
  "import": [
    "@cspell/dict-en-ca/cspell-ext.json",
    "cspell-dict-fr-ca/cspell-ext.json"
  ],
  "ignorePaths": [
    ".git/**",
    "build/**",
    "dist/**",
    "node_modules/**",
    "package-lock.json",
    "public/**",
    "resources/**",
    "wip/**",
    "_wip/**"
  ],
  "ignoreRegExpList": [
    "/<[^>]+>/g",
    "/https?:\\/\\/[^\\s)]+/g",
    "/:[a-z0-9_+-]+:/g",
    "/`[^`\\n]+`/g"
  ],
  "flagWords": [
    "behavior",
    "behavioral",
    "behaviors",
    "catalog",
    "catalogs",
    "center",
    "centered",
    "centering",
    "centers",
    "color",
    "colored",
    "colorful",
    "coloring",
    "colors",
    "defense",
    "endeavor",
    "enrollment",
    "favor",
    "favorable",
    "favored",
    "favoring",
    "favorite",
    "favorites",
    "favors",
    "flavor",
    "flavors",
    "fulfill",
    "fulfills",
    "gray",
    "harbor",
    "honor",
    "honored",
    "honors",
    "humor",
    "jewelry",
    "labor",
    "neighbor",
    "neighbors",
    "offense",
    "rumor",
    "theater"
  ],
  "words": [
    "Alphanum",
    "Benoît",
    "CAIQ",
    "choosealicense",
    "Dicaire",
    "Gists",
    "highcontrast",
    "Keycap",
    "Linters",
    "merko",
    "monokai",
    "nord",
    "onedark",
    "strikethroughs",
    "synthwave",
    "tokyonight",
    "zenburn"
  ]
}
